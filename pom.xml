<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 http://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>
    <groupId>vv.seconddegre</groupId>
    <artifactId>second-degre-pairwise</artifactId>
    <version>1.0-SNAPSHOT</version>
    <packaging>jar</packaging>

    <name>Projet V&amp;V - Solveur 2nd Degre</name>
    <description>
        Solveur d'equation du second degre avec tests Pairwise,
        tests metamorphiques, couverture JaCoCo et mutation PIT.
    </description>

    <properties>
        <!-- Java 17 compatible avec l'environnement installe -->
        <maven.compiler.source>17</maven.compiler.source>
        <maven.compiler.target>17</maven.compiler.target>
        <project.build.sourceEncoding>UTF-8</project.build.sourceEncoding>

        <!-- Versions des plugins de mesure -->
        <jacoco.version>0.8.12</jacoco.version>
        <pit.version>1.17.3</pit.version>

        <!-- ======================================================
             SEUILS DE QUALITE (a atteindre / maintenir)
             - JaCoCo : 100% des BRANCHES sur le code principal
             - PIT    : score de mutation >= 85% (hors equivalents)
             ====================================================== -->
        <jacoco.branch.coverage>1.00</jacoco.branch.coverage>
        <jacoco.instruction.coverage>1.00</jacoco.instruction.coverage>
        <jacoco.line.coverage>1.00</jacoco.line.coverage>
        <jacoco.method.coverage>1.00</jacoco.method.coverage>
        <jacoco.class.coverage>1.00</jacoco.class.coverage>
        <mutation.score.minimum>0.85</mutation.score.minimum>
    </properties>

    <dependencies>
        <!-- JUnit Jupiter (API, params, engine) -->
        <dependency>
            <groupId>org.junit.jupiter</groupId>
            <artifactId>junit-jupiter-api</artifactId>
            <version>5.11.0</version>
            <scope>test</scope>
        </dependency>
        <dependency>
            <groupId>org.junit.jupiter</groupId>
            <artifactId>junit-jupiter-params</artifactId>
            <version>5.11.0</version>
            <scope>test</scope>
        </dependency>
        <dependency>
            <groupId>org.junit.jupiter</groupId>
            <artifactId>junit-jupiter-engine</artifactId>
            <version>5.11.0</version>
            <scope>test</scope>
        </dependency>
    </dependencies>

    <build>
        <plugins>
            <!-- Lanceur de tests JUnit 5 -->
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-surefire-plugin</artifactId>
                <version>3.2.5</version>
            </plugin>

            <!-- ===================================================
                 JaCoCo : couverture de code
                 Rapport HTML  : target/site/jacoco/index.html
                 Rapport CSV   : target/site/jacoco/jacoco.csv
                 Seuils : voir properties ci-dessus (100% branches)
                 =================================================== -->
            <plugin>
                <groupId>org.jacoco</groupId>
                <artifactId>jacoco-maven-plugin</artifactId>
                <version>${jacoco.version}</version>
                <executions>
                    <!-- 1) Agent de mesure pendant les tests -->
                    <execution>
                        <id>prepare-agent</id>
                        <goals>
                            <goal>prepare-agent</goal>
                        </goals>
                    </execution>
                    <!-- 2) Rapport apres les tests -->
                    <execution>
                        <id>report</id>
                        <phase>test</phase>
                        <goals>
                            <goal>report</goal>
                        </goals>
                    </execution>
                    <!-- 3) Verifie les seuils de couverture -->
                    <execution>
                        <id>check</id>
                        <phase>verify</phase>
                        <goals>
                            <goal>check</goal>
                        </goals>
                        <configuration>
                            <rules>
                                <rule>
                                    <element>BUNDLE</element>
                                    <limits>
                                        <limit>
                                            <counter>BRANCH</counter>
                                            <value>COVEREDRATIO</value>
                                            <minimum>${jacoco.branch.coverage}</minimum>
                                        </limit>
                                        <limit>
                                            <counter>INSTRUCTION</counter>
                                            <value>COVEREDRATIO</value>
                                            <minimum>${jacoco.instruction.coverage}</minimum>
                                        </limit>
                                        <limit>
                                            <counter>LINE</counter>
                                            <value>COVEREDRATIO</value>
                                            <minimum>${jacoco.line.coverage}</minimum>
                                        </limit>
                                        <limit>
                                            <counter>METHOD</counter>
                                            <value>COVEREDRATIO</value>
                                            <minimum>${jacoco.method.coverage}</minimum>
                                        </limit>
                                        <limit>
                                            <counter>CLASS</counter>
                                            <value>COVEREDRATIO</value>
                                            <minimum>${jacoco.class.coverage}</minimum>
                                        </limit>
                                    </limits>
                                </rule>
                            </rules>
                        </configuration>
                    </execution>
                </executions>
            </plugin>

            <!-- ===================================================
                 PIT : test de mutation
                 Rapport HTML : target/pit-reports/index.html
                 Seuil        : mutation.score.minimum (85%)
                 =================================================== -->
            <plugin>
                <groupId>org.pitest</groupId>
                <artifactId>pitest-maven</artifactId>
                <version>${pit.version}</version>
                <dependencies>
                    <!-- Support JUnit 5 pour PIT -->
                    <dependency>
                        <groupId>org.pitest</groupId>
                        <artifactId>pitest-junit5-plugin</artifactId>
                        <version>1.2.1</version>
                    </dependency>
                </dependencies>
                <configuration>
                    <targetClasses>
                        <param>vv.seconddegre.*</param>
                    </targetClasses>
                    <targetTests>
                        <param>vv.seconddegre.*</param>
                    </targetTests>
                    <!-- Surfaces de mutation a analyser -->
                    <mutators>
                        <mutator>DEFAULTS</mutator>
                        <mutator>CONDITIONALS_BOUNDARY</mutator>
                        <mutator>INCREMENTS</mutator>
                        <mutator>INVERT_NEGS</mutator>
                        <mutator>NEGATE_CONDITIONALS</mutator>
                        <mutator>VOID_METHOD_CALLS</mutator>
                        <mutator>REMOVE_CONDITIONALS</mutator>
                        <mutator>TRUE_RETURNS</mutator>
                        <mutator>FALSE_RETURNS</mutator>
                        <mutator>EMPTY_RETURNS</mutator>
                        <mutator>NULL_RETURNS</mutator>
                        <mutator>PRIMITIVE_RETURNS</mutator>
                    </mutators>
                    <!-- Rapport HTML + CSV + XML -->
                    <outputFormats>
                        <param>HTML</param>
                        <param>CSV</param>
                        <param>XML</param>
                    </outputFormats>
                    <timestampedReports>false</timestampedReports>
                    <exportLineCoverage>true</exportLineCoverage>
                    <verbose>2</verbose>
                </configuration>
                <executions>
                    <execution>
                        <id>mutation-tests</id>
                        <phase>verify</phase>
                        <goals>
                            <goal>mutationCoverage</goal>
                        </goals>
                    </execution>
                </executions>
            </plugin>
        </plugins>
    </build>
</project>
